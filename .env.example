# Public URL of the Go API, used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080
# This site's own public URL, used to resolve absolute OG/Twitter image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# URL the Next.js server uses to reach the API (the service name inside Docker).
API_INTERNAL_URL=http://localhost:8080
