# Public URL of the Go API, used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080
# This site's own public URL, used to resolve absolute OG/Twitter image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# URL the Next.js server uses to reach the API (the service name inside Docker).
API_INTERNAL_URL=http://localhost:8080
# WhatsApp number hosts chat with to unlock premium designs: digits only, international format, no "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000
# Cloudflare Web Analytics beacon token (dashboard -> Analytics & Logs -> Web Analytics). Server-side, read at
# runtime; leave unset to disable analytics. Production only.
CF_BEACON_TOKEN=bd7e7974061143aea3dce3a9f7500e23
